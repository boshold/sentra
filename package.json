{
  "name": "sentra",
  "private": true,
  "license": "MIT",
  "author": "Kevin Boshold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boshold/sentra.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c test/integration/vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "lint": "oxfmt --check && oxlint --type-aware --deny-warnings",
    "lint:fix": "oxfmt --write && oxlint --type-aware --fix --deny-warnings",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test:coverage",
    "capture:fixtures": "tsx scripts/capture-fixtures.ts",
    "smoke:bun": "tsx scripts/bun-compile-smoke.ts"
  },
  "devDependencies": {
    "@bosdev/sentra-core": "workspace:*",
    "@happy-dom/global-registrator": "^20.14.5",
    "@sentry/browser": "^11.7.0",
    "@sentry/node": "^11.7.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue": "^3.5.44",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@12.9.1"
}
