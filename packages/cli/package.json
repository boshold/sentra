{
  "name": "@bosdev/sentra-cli",
  "version": "0.1.0",
  "description": "Standalone local Sentry-compatible event receiver with live terminal output, HTTP query API and MCP endpoint.",
  "homepage": "https://github.com/boshold/sentra#readme",
  "bugs": {
    "url": "https://github.com/boshold/sentra/issues"
  },
  "license": "MIT",
  "author": "Kevin Boshold",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boshold/sentra.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sentra": "./dist/cli.mjs"
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "publishConfig": {
