    "url": "git+https://github.com/boshold/sentra.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sentra": "./dist/cli.mjs"
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
