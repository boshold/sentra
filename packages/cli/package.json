{
  "name": "@boshold/sentra-cli",
  "version": "0.0.0",
  "description": "Standalone local Sentry-compatible event receiver with live terminal output, HTTP query API and MCP endpoint.",
  "homepage": "https://github.com/boshold/sentra#readme",
  "bugs": {
    "url": "https://github.com/boshold/sentra/issues"
  },
  "license": "MIT",
  "author": "Kevin Boshold",
  "repository": {
